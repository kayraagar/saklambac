{
  "expo": {
    "name": "Saklambaç",
    "slug": "saklambac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saklambac",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saklambaç, oyun alanındaki yerini haritada göstermek ve oyun sırasında takımınla paylaşmak için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "Saklambaç, telefon cebindeyken veya ekran kapalıyken de oyunun sürmesi için konumunu arka planda kullanır. Konum yalnızca oyun sırasında paylaşılır.",
          "locationAlwaysPermission": "Saklambaç, telefon cebindeyken veya ekran kapalıyken de oyunun sürmesi için konumunu arka planda kullanır. Konum yalnızca oyun sırasında paylaşılır.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8F135",
          "defaultChannel": "game",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
